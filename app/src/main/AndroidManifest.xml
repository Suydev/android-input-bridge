<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.inputbridge">

    <!-- USB Host: read the Portronics receiver over OTG -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- BUG-157 FIX: on Android 10 (API 29) UsbManager.requestPermission() only actually
         grants openDevice() access if the app declares this permission. Without it the
         permission dialog appears but openDevice() still returns null, so the bridge loops
         on "USB device not found". Declaring it is what makes the Android USB host API work. -->
    <uses-permission android:name="android.permission.USB_PERMISSION" />

    <!-- Network transport -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- Wi-Fi Direct (future) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <!-- Foreground service: keep bridge alive -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Battery optimization: ask user to exempt us -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Auto-start on boot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Bluetooth HID (optional, feature-flagged) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />

    <!-- Vibrate on tap (mouse trackpad haptic feedback) -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Cursor dot overlay. Required by CursorOverlayService. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Shizuku: privileged input injection via InputManager -->
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS_FULL" />

    <application
        android:name=".InputBridgeApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.InputBridge">

        <!-- Mode Selection Activity - Entry point -->
        <activity
            android:name=".ui.ModeSelectionActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Bridge Mode Activity -->
        <!-- BUG-169: exported=true so the system can auto-launch on USB_DEVICE_ATTACHED -->
        <activity
            android:name=".ui.bridge.BridgeModeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.InputBridge.Bridge">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <!-- Trackpad Activity (Bridge Mode) -->
        <activity
            android:name="com.inputbridge.bridge.ui.MouseTrackpadActivity"
            android:exported="false"
            android:theme="@style/Theme.InputBridge.Trackpad"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize" />

        <!-- Receiver Mode Activity -->
        <activity
            android:name=".ui.receiver.ReceiverModeActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:theme="@style/Theme.InputBridge.Receiver" />

        <!-- Bridge Service: USB capture + UDP/BT HID transport -->
        <service
            android:name="com.inputbridge.bridge.service.BridgeService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice"
            android:enabled="true" />

        <!-- Receiver Service: UDP receiver + input injection -->
        <service
            android:name="com.inputbridge.receiver.service.ReceiverService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice"
            android:enabled="true" />

        <!-- Cursor Overlay Service -->
        <service
            android:name="com.inputbridge.receiver.service.CursorOverlayService"
            android:exported="false"
            android:enabled="true" />

        <!-- Bridge Accessibility Service: USB keyboard capture -->
        <service
            android:name="com.inputbridge.bridge.service.BridgeAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/bridge_accessibility_service_config" />
        </service>

        <!-- Receiver Accessibility Service: Input injection via Shizuku/dispatchGesture -->
        <service
            android:name="com.inputbridge.accessibility.InputBridgeAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label_receiver"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Shizuku Provider for privileged input injection -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Auto-start on boot -->
        <receiver
            android:name="com.inputbridge.bridge.receiver.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.inputbridge.receiver.receiver.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>