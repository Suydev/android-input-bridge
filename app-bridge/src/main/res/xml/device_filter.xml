<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        USB device filter for the Portronics Key2 Combo receiver (and any standard HID dongle).

        BUG-013 FIX: class="3" matches device-level USB class HID.
        BUG-099 FIX: Many combo receivers (including Portronics Key2 Combo) report device
        class=0 (defined at interface level) with HID interfaces underneath. Adding class="0"
        ensures the USB_DEVICE_ATTACHED intent fires for these devices too.
        BridgeService validates interface class at runtime before starting capture.
    -->
    <usb-device class="3" />
    <usb-device class="0" />
</resources>
